# Interactive scheduling without a 1000 Hz timer or RT-kernel complexity.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SWAP=y
CONFIG_MEMCG=y
# Fast compressed swap; no disk writeback or redundant compression streams.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=n
CONFIG_ZRAM_WRITEBACK=n
CONFIG_ZRAM_MULTI_COMP=n
# Native nftables: firewall rules and NetworkManager connection sharing.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
# wg-quick full-tunnel anti-spoofing uses the nft fib expression.
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NF_LOG_SYSLOG=m
CONFIG_TUN=m
CONFIG_WIREGUARD=m
# Modern removable-media and encrypted-device support, loaded on demand.
CONFIG_EXFAT_FS=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_AES_NI_INTEL=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
# Keep CPU defenses; do not trade security for benchmark numbers.
CONFIG_CPU_MITIGATIONS=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_LIST_HARDENED=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,yama,apparmor"
