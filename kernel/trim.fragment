# Laptop profile: no kernel hypervisor, netboot, server filesystems or PCMCIA.
# Debug symbols/tracers are omitted, but printk, kallsyms and SysRq stay usable.
CONFIG_HIBERNATION=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_CRASH_DUMP=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_KUNIT=n
CONFIG_PROFILING=n
CONFIG_KALLSYMS_ALL=n
CONFIG_CGROUP_DEBUG=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_USB_MON=n
CONFIG_PM_DEBUG=n
CONFIG_KVM=n
CONFIG_KVM_GUEST=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_PARAVIRT=n
CONFIG_NET_9P=n
CONFIG_VIRTIO_PCI=n
CONFIG_VIRTIO_BLK=n
CONFIG_SCSI_VIRTIO=n
CONFIG_VIRTIO_NET=n
CONFIG_VIRTIO_CONSOLE=n
CONFIG_VIRTIO_BALLOON=n
CONFIG_VIRTIO_INPUT=n
CONFIG_VIRTIO_MMIO=n
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM_QXL=n
CONFIG_DRM_BOCHS=n
CONFIG_NET_9P_VIRTIO=n
CONFIG_NUMA=n
CONFIG_NUMA_BALANCING=n
CONFIG_HUGETLBFS=n
CONFIG_HUGETLB_PAGE=n
CONFIG_MEMORY_HOTPLUG=n
CONFIG_ACPI_HOTPLUG_MEMORY=n
CONFIG_PCCARD=n
CONFIG_MACINTOSH_DRIVERS=n
CONFIG_EEEPC_LAPTOP=n
CONFIG_INFINIBAND=n
CONFIG_FIREWIRE=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_IP_PNP=n
CONFIG_IP_MROUTE=n
CONFIG_IP_PIMSM_V1=n
CONFIG_IP_PIMSM_V2=n
CONFIG_TCP_MD5SIG=n
CONFIG_NET_TULIP=n
CONFIG_SND_SEQUENCER=n
CONFIG_SND_SEQ_DUMMY=n
CONFIG_MODULE_FORCE_LOAD=n
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_PROC_KCORE=n
CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=n
# nftables replaces the generic defconfig's legacy iptables implementation.
CONFIG_NETFILTER_XTABLES=n
CONFIG_IP_NF_IPTABLES=n
CONFIG_IP6_NF_IPTABLES=n
CONFIG_NF_CONNTRACK_FTP=n
CONFIG_NF_CONNTRACK_IRC=n
CONFIG_NF_CONNTRACK_SIP=n
# No SELinux policy is shipped; use the AppArmor/landlock stack instead.
CONFIG_SECURITY_SELINUX=n
