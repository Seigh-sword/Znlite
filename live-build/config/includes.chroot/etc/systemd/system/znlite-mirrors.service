[Unit]
Description=Measure and select a signed Debian mirror (best effort)
After=network.target
ConditionPathExists=/etc/znlite/mirrors.json

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/znlite-mirrors.py select
TimeoutStartSec=90
Nice=10
IOSchedulingClass=idle
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/apt/sources.list.d /var/lib/znlite-mirrors /var/lib/apt/lists /run
